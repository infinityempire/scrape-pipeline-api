# Target URL for the scheduled GitHub Actions scraper.
TARGET_URL=https://example.com

# Copy both values from Upstash Console > Redis database > REST API.
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Optional cache tuning. The scheduler writes each result for 24 hours by default.
UPSTASH_CACHE_KEY=scrape:latest
CACHE_TTL_SECONDS=86400
SCRAPE_TIMEOUT_MS=15000

# Used by the lightweight local cache API.
PORT=8080
MAX_REQUEST_BODY_BYTES=10kb

# Used by the static site generator. On GitHub Actions, set these as repository secrets.
SITE_URL=https://your-github-user.github.io/scrape-pipeline-api
PAYPAL_ME_LINK=https://www.paypal.com/paypalme/your-handle
ADSENSE_PUB_ID=ca-pub-1234567890123456

# Required before scheduled collection. Confirm that you may access and excerpt the target source.
SOURCE_PERMISSION_CONFIRMED=false

# Keep indexing disabled until you document a source-specific, original benefit for visitors.
ORIGINAL_VALUE_STATEMENT=
ENABLE_SEARCH_INDEXING=false
