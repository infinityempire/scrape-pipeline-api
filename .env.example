# HTTP listener port. Render/Railway inject this automatically; use 3000 locally.
PORT=3000

# redis://localhost:6379 locally, or the private connection string of the managed store.
REDIS_URL=redis://localhost:6379

# Use a high-entropy secret. Never commit its actual value.
API_KEY=replace-with-a-long-random-secret

# Operational tuning.
SCRAPE_TIMEOUT_MS=15000
CACHE_TTL_SECONDS=3600
WORKER_CONCURRENCY=2

# Keep false in deployed environments to prevent server-side request forgery.
ALLOW_PRIVATE_NETWORKS=false
