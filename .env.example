# Koyeb exposes the service on this port. It injects PORT automatically when needed.
PORT=8080

# Upstash Redis TLS connection string for ioredis. The colon before the password is required.
REDIS_URL=rediss://:password@your-upstash-endpoint.upstash.io:6379

# Generate a high-entropy secret with: openssl rand -base64 32
API_KEY=your_secret_key

# Keep requests bounded on the 512 MB Koyeb Free Instance.
SCRAPE_TIMEOUT_MS=15000
CACHE_TTL_SECONDS=3600
MAX_REQUEST_BODY_BYTES=10kb

# Keep false in deployed environments to prevent server-side request forgery.
ALLOW_PRIVATE_NETWORKS=false
