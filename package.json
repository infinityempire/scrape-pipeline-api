{
  "name": "scrape-pipeline-api",
  "version": "1.0.0",
  "description": "Authenticated, queued web extraction API with Redis caching.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
