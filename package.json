{
  "name": "scrape-pipeline-api",
  "version": "2.0.0",
  "description": "Scheduled open research pipeline using the GitHub REST Search API, Upstash Redis snapshots, and GitHub Pages.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "scrape": "node src/scraper.js",
    "build:site": "node src/build_site.js",
    "test": "node --test",
    "lint": "node --check src/*.js && node --check test/*.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0"
  }
}
